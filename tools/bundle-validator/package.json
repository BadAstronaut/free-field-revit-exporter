{
  "name": "@freefield/bundle-validator",
  "version": "0.1.0",
  "private": true,
  "description": "Validates .ffbundle files: schema, file references, PDF sizes, storeys and geometric PDF-to-IFC alignment.",
  "type": "module",
  "bin": {
    "ffbundle-validate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "make-fixture": "node dist/fixture/make-fixture.js",
    "test": "npm run build && node --test dist/test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "web-ifc": "0.0.80",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2",
    "yazl": "^3.3.1"
  }
}
